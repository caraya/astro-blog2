    '  const variants = {\n' +
    '    primary: "bg-blue-600 text-white hover:bg-blue-700",\n' +
    '    secondary: "bg-gray-200 text-gray-800 hover:bg-gray-300",\n' +
    '    danger: "bg-red-600 text-white hover:bg-red-700",\n' +
    '  };\n' +
    '\n' +
    '  return (\n' +
    '    <button\n' +
    '      type={type}\n' +
