    "    window.removeEventListener('youtube-embed-activate', this.boundResetHandler);\n" +
    '  }\n' +
    '\n' +
    '  formatDim(val: string): string {\n' +
    '    return /^\\d+$/.test(val) ? `${val}px` : val;\n' +
