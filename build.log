    '\t\t\t},\n' +
    '\t\t\t&mermaid.Extender{},\n' +
    '\t\t),\n' +
    '\t\tgoldmark.WithParserOptions(\n' +
    '\t\t\tparser.WithAutoHeadingID(),\n' +
    '\t\t),\n' +
    '\t\tgoldmark.WithRendererOptions(\n' +
    '\t\t\thtml.WithXHTML(),\n' +
    '\t\t),\n' +
    '\t)\n' +
    '}In processFile we will process the front matter content by calling extractFrontmatterAndContentfunc processFile(sourceFileName, destDir string, md goldmark.Markdown) {\n' +
    '\n' +
    '\t// Extract frontmatter and content\n' +
    '\tfrontmatter, content, err := extractFrontmatterAndContent(fileContent)\n' +
    '\tif err != nil {\n' +
    '\t\tfmt.Printf("Failed to extract frontmatter: %v", err)\n' +
    '\t}\n' +
    '\n' +
    '\tvar data FrontMatterData\n' +
    '\tif err := yaml.Unmarshal([]byte(frontmatter), &data); err != nil {\n' +
    '\t\tfmt.Printf("Failed to unmarshal frontmatter: %v", err)\n' +
    '\t}\n' +
    '\n' +
    '\tvar buf bytes.Buffer\n' +
    '\tif err := md.Convert([]byte(content), &buf); err != nil {\n' +
    '\t\tfmt.Printf("Failed to convert Markdown content: %v\\n", err)\n' +
    '\t\treturn\n' +
    '\t}\n' +
    '\n' +
    '\twriteHTMLToFile(buf, sourceFileName, destDir, data)\n' +
    '}The extractFrontmatterAndContent function will extract the YAML front matter from the top of each document and pass the data to the calling function.func extractFrontmatterAndContent(fileContent []byte) (frontmatter, content string, err error) {\n' +
    '\tconst delimiter = "---"\n' +
    '\tcontentStr := string(fileContent)\n' +
    '\n' +
    '\tif !strings.HasPrefix(contentStr, delimiter) {\n' +
    '\t\treturn "", contentStr, nil\n' +
    '\t}\n' +
    '\n' +
    '\tparts := strings.SplitN(contentStr, delimiter, 3)\n' +
    '\n' +
    '\tif len(parts) < 3 {\n' +
