    '      <img src="https://i.ytimg.com/vi/${this.videoId}/hqdefault.jpg" loading="lazy" alt="Video Thumbnail" />\n' +
    '      <div class="btn"></div>\n' +
    '    `;\n' +
    "    this.addEventListener('click', this.activate, { once: true });\n" +
    '\n' +
    '    // Accessibility\n' +
    "    this.setAttribute('tabindex', '0');\n" +
    "    this.setAttribute('role', 'button');\n" +
    "    this.setAttribute('aria-label', `Play video`);\n" +
    '  }\n' +
    '\n' +
    '  activate = (): void => {\n' +
    "    window.dispatchEvent(new CustomEvent('youtube-embed-activate', { detail: { activeElement: this } }));\n" +
    "    const autoplay = this.hasAttribute('autoplay') ? '?autoplay=1' : '';\n" +
    '    this.shadowRoot!.innerHTML = `\n' +
