reading-time plugin: {
  textOnPage: 'Most modern libraries and frameworks have a command line interface that will make it easier to build your own applications using the particular framework. Look at Angular CLI or Polymer CLI for an idea of what I’m talking about.The idea is that we can create a tool like a Yeoman generator without having to learn the way Yeoman works.Getting startedTo start create a package.json file.npm initWe’ll install the application’s dependencies next. Note that as of NPM 5.0 we don’t need to indicate we’re saving them as dependecies (--save) as this is assumed when you install a package.npm install caporal colors prompt shelljsEdit the package.json file so that it looks like the exmaple below.Pay special attention to the bin section of the package. we’ve created a scaffold script that will run index.js.{\n' +
    '  "name": "scaffold",\n' +
    '  "version": "1.0.0",\n' +
    '  "main": "index.js",\n' +
    '  "bin": {\n' +
    '    "scaffold": "index.js"\n' +
    '  },\n' +
    '  "dependencies": {\n' +
    '    "caporal": "^0.3.0",\n' +
    '    "colors": "^1.1.2",\n' +
    '    "prompt": "^1.0.0",\n' +
    '    "shelljs": "^0.7.7"\n' +
    '  }\n' +
    '}Buildng the appAt a minimum Caporal requires:a commandone or more argumentsan action to execute when we use the commandThe example below will take a template and, optionally, a variant of the template we want to create. It will log the arguments and options to the console.#!/usr/bin/env node\n' +
    '\n' +
    "const prog = require('caporal');\n" +
    '\n' +
    'prog\n' +
    "  .version('1.0.0')\n" +
    "  .command('create', 'Create a new application')\n" +
    "  .argument('<template>', 'Template to use')\n" +
    "  .option('--variant <variant>', 'Which <variant> of the template we\\'ll create')\n" +
    '  .action((args, options, logger) => {\n' +
    '    console.log({\n' +
    '      args: args,\n' +
    '      options: options\n' +
    '    });\n' +
    '  });\n' +
    '\n' +
    "prog.parse(process.argv);To test the program use NPM’s link to add the project to our global npm space without having to publish it to the NPM registry and download it back to our development workstation.npm linkThis will put your scripts in your path and allow you to run your script without prepending the full path.scaffold --helpIf we run the full command:scaffold create node --variant mvcWe should get this in response:{ args: { template: 'node' }, options: { variant: 'mvc' } }I know, we don’t really need to log the data we’ve just entered so we can change the action to point to a separate file (discussed below)#!/usr/bin/env node\n" +
    '\n' +
    "const prog = require('caporal');\n" +
    "const createCommand = require('./lib/create');\n" +
    '\n' +
    'prog\n' +
    "  .version('0.0.1')\n" +
    "  .command('create', 'Create a new element')\n" +
    "  .argument('<element>', 'Element template to use')\n" +
    "  .option('--element-name <name>', 'What element we want to create')\n" +
    '  .action(createCommand);\n' +
    '\n' +
    "prog.parse(process.argv);The create.js file host all the application logic for the create command and is isolated from other commands and the Caporal logic itself. We’re using Shelljs to run Unix commands in our project and prompt to get user input.The commands will prompt the user, replace placeholder elements, and copy content from our template to the elements we create.const prompt = require('prompt');\n" +
    "const shell = require('shelljs');\n" +
    "const fs = require('fs');\n" +
    'const colors = require("colors/safe");\n' +
    '\n' +
    '// Set prompt as blue\n' +
    'prompt.message = colors.blue("Replace");\n' +
    '\n' +
    '// Command function\n' +
    '\n' +
    'module.exports = (args, options, logger) => {\n' +
    "  const variant = options.variant || 'default';\n" +
    '  const elementPath = `${__dirname}/../elements/${args.element}/${variant}`;\n' +
    '  const localPath = process.cwd();\n' +
    '  // File variables\n' +
    '  const variables = require(`${elementPath}/_variables`);\n' +
    '\n' +
    '  // Copy Element\n' +
    "  // If the element path doesn't exist, bail\n" +
    '  if !(fs.existsSync(elementPath)) {\n' +
    '    logger.error(`The requested element for ${args.element} wasn’t found.`)\n' +
    '    process.exit(1);\n' +
    '  } else {\n' +
    '    // otherwise copy the files\n' +
    "    logger.info('Copying files…');\n" +
    "    shell.cp('-R', `${elementPath}/*`, localPath);\n" +
    "    logger.info('✔ The files have been copied!');\n" +
    '  }\n' +
    '\n' +
    '  // Remove variables file from the current directory\n' +
    '  // since we only need it on the template directory\n' +
    '  if (fs.existsSync(`${localPath}/_variables.js`)) {\n' +
    '    shell.rm(`${localPath}/_variables.js`);\n' +
    '  }\n' +
    '\n' +
    "  logger.info('Please fill the following values…');\n" +
    '\n' +
    '  // Ask for variable values\n' +
    '  prompt.start().get(variables, (err, result) => {\n' +
    '\n' +
    '    // Remove MIT License file if another is selected\n' +
    "    if (result.license !== 'MIT') {\n" +
    '      shell.rm(`${localPath}/LICENSE`);\n' +
    '    }\n' +
    '\n' +
    '    // Replace variable values in all files\n' +
    "    shell.ls('-Rl', '.').forEach(entry => {\n" +
    '      if (entry.isFile()) {\n' +
    "        // Replace '[VARIABLE]` with the variable value\n" +
    '        // from the prompt\n' +
    '        variables.forEach(variable => {\n' +
    "          shell.sed('-i', `\\\\[${variable.toUpperCase()}\\\\]`,\n" +
    '          result[variable], entry.name);\n' +
    '        });\n' +
    '\n' +
    '        // Insert current year in files\n' +
    "        shell.sed('-i', '\\\\[YEAR\\\\]', new Date().getFullYear(),\n" +
    '        entry.name);\n' +
    '      }\n' +
    '    });\n' +
    '\n' +
    "    logger.info('✔ Success!');\n" +
    '  });\n' +
    '}Building templatesNow that we have the logic for creating elements, let’s look at creating the templates we’ll use as the original for each element.Each element has its own template and we may have more than one set of templates for our application. The structure may look like this tree..\n' +
    '└─ elements\n' +
    '  └─ default\n' +
    '  └── publish-video\n' +
    '  └── publish-content\n' +
    '  └── publish-grid\n' +
    '└─ applicationWe’ll look at the default element that will act as our default template. Each element will mirror the structure of this default element. The directory has the following structure:.\n' +
    '├── LICENSE\n' +
    '├── _variables.js\n' +
    '├── lib\n' +
    '├── package.json\n' +
    '├── myElement.jsLICENSE is our element’s license. MIT by default_varaiables.js contains the itemsllib is a directory to hold any additional files we needpackage.jsonmyElement.js_variables.js contains the variables we want to replace in our elements. The replacement and processing is handled in the create script so we’ll just present the file as is.//  Variables to replace\n' +
    '//\n' +
    '//  They are asked to the user as they appear here.\n' +
    '//  User input will replace the placeholder values\n' +
    '//  in the template files\n' +
    '\n' +
    'module.exports = [\n' +
    "  'name',\n" +
    "  'version',\n" +
    "  'description',\n" +
    "  'author',\n" +
    "  'license'\n" +
    '];The package.json files is an example of what the template looks like. Variables to be replaced match the names in _variables.js. {\n' +
    '  "name": "[NAME]",\n' +
    '  "version": "[VERSION]",\n' +
    '  "description": "[DESCRIPTION]",\n' +
    '  "main": "server.js",\n' +
    '  "scripts": {\n' +
    '    "test": "echo \\"Error: no test specified\\" && exit 1",\n' +
    '    "start": "node server.js",\n' +
    '    "start:dev": "nodemon server.js"\n' +
    '  },\n' +
    '  "author": "[AUTHOR]",\n' +
    '  "license": "[LICENSE]",\n' +
    '  "dependencies": {\n' +
    '    "dotenv": "^2.0.0",\n' +
    '    "hapi": "^16.1.0",\n' +
    '    "hoek": "^4.1.0"\n' +
    '  },\n' +
    '  "devDependencies": {\n' +
    '    "nodemon": "^1.11.0"\n' +
    '  }\n' +
    '}myElement.js is the core of the template. We create a V1 Custom Element and take advantage of features in the specification, working with observed attributes and reflecting changes in the attributes to the code and vice versa.Custom Elements V1 use only ES2015 exclusively.class myElement extends HTMLElement {\n' +
    '\n' +
    '  static get observedAttributes() {\n' +
    "    return ['disabled'];\n" +
    '  }\n' +
    '  // A getter/setter for a disabled property.\n' +
    '  get disabled() {\n' +
    "    return this.hasAttribute('disabled');\n" +
    '  }\n' +
    '\n' +
    '  set disabled(val) {\n' +
    '    if (val) {\n' +
    "      this.setAttribute('disabled', '');\n" +
    '    } else {\n' +
    "      this.removeAttribute('disabled');\n" +
    '    }\n' +
    '  }\n' +
    '\n' +
    '  // Can define constructor arguments if you wish.\n' +
    '  constructor() {\n' +
    '    // If you define a constructor, always call super() first!\n' +
    '    // This is specific to CE and required by the spec.\n' +
    '    super();\n' +
    '\n' +
    '  }\n' +
    '\n' +
    '  attributeChangedCallback(name, oldValue, newValue) {\n' +
    '    // When the drawer is disabled, update keyboard/screen reader behavior.\n' +
    '    if (this.disabled) {\n' +
    "      this.setAttribute('tabindex', '-1');\n" +
    "      this.setAttribute('aria-disabled', 'true');\n" +
    '    } else {\n' +
    "      this.setAttribute('tabindex', '0');\n" +
    "      this.setAttribute('aria-disabled', 'false');\n" +
    '    }\n' +
    '  }\n' +
    '}\n' +
    '\n' +
    '// Associate the custom element with the class we just created\n' +
    "customElements.define('my-element', myElement);So now that we have it all together we can publish it to NPM if we so choose because we linked the CLI tool using NPM we can run it without uploading it.",
  readingTime: { text: '6 min read', minutes: 5.335, time: 320100, words: 1067 }
}
