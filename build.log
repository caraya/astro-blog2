    '    <div className="card">\n' +
    '      {image && <img src={image} alt="" />}\n' +
    '\n' +
    '      <div className="content">\n' +
    '        <h3>{title}</h3>\n' +
    '        {subtitle && <p>{subtitle}</p>}\n' +
    '\n' +
    '        {/* Conditional Logic Hell */}\n' +
    "        {type === 'product' && onBuy && (\n" +
    '          <button onClick={onBuy}>Buy Now</button>\n' +
    '        )}\n' +
    '\n' +
    "        {type === 'user' && onlineStatus && (\n" +
    '          <div className={`status-dot ${onlineStatus}`} />\n' +
    '        )}\n' +
    '\n' +
