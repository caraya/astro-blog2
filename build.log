    '\n' +
    "    this.style.setProperty('--w', width);\n" +
    "    this.style.setProperty('--h', height);\n" +
    "    this.style.setProperty('--r', ratio);\n" +
    '\n' +
    "    window.addEventListener('youtube-embed-activate', this.boundResetHandler);\n" +
    '    this.renderThumbnail();\n' +
