    '}\n' +
    '\n' +
    '.box {\n' +
    '  width: 200px;\n' +
    '  height: 200px;\n' +
    '  display: flex;\n' +
    '  align-items: center;\n' +
    '  justify-content: center;\n' +
    '}\n' +
    '\n' +
    '.button-row {\n' +
    '  margin-block: 2em;\n' +
    '  width: 200px;\n' +
    '  display: flex;\n' +
    '  flex-flow: row wrap;\n' +
    '  gap: 0.75em;\n' +
    '}\n' +
    '\n' +
    'button: {\n' +
    '  width: 45px;\n' +
    '}\n' +
    '\n' +
    '.thin {\n' +
    '  border: 5px solid black;\n' +
    '}\n' +
    '\n' +
    '.thick {\n' +
    '  border: 10px solid black;\n' +
    '}\n' +
    '\n' +
    '.hotpink {\n' +
    '  background: hotpink;\n' +
    '  color: white;\n' +
    '}\n' +
    '\n' +
    '.blue {\n' +
    '  background: navy;\n' +
    '  color: white;\n' +
    '}The Javascript code does the bulk of the work since it actually trigger the class changes.In the first part of the code we capture references to the box and the buttons on the page using querySelector. If you have more than one element that matches the query then querySelector will only return the first ocurrence, if you want to work with all the matching elements use querySelectorAllconst myBox = document.querySelector("#myBox");\n' +
    '\n' +
    'const add = document.querySelector("#addBtn");\n' +
    'const remove = document.querySelector("#removeBtn");\n' +
    'const replace = document.querySelector("#replaceBtn");\n' +
    'const toggle = document.querySelector("#toggleBtn");The next step is to define event listeners for each button we created.The remove (removeBtn) and replace (replaceBtn) use classList.contains to test if the class or classes we want to remove or replace exists before taking action.This is particularly important with the classList.replace method since it will throw an error if the class we want to replace doesn’t exist. So to avoid errors, making sure you’re replacing a class that exists or provide a workaround like what we did here.addBtn.addEventListener("click", (evt) => {\n' +
    '  myBox.classList.add("hotpink");\n' +
    '});\n' +
    '\n' +
    'removeBtn.addEventListener("click", (evt) => {\n' +
    '  if (myBox.classList.contains("hotpink")) {\n' +
    '    myBox.classList.remove("hotpink");\n' +
    '  }\n' +
    '  if (myBox.classList.contains("blue")) {\n' +
    '    myBox.classList.remove("blue");\n' +
    '  }\n' +
    '});\n' +
    '\n' +
    'replaceBtn.addEventListener("click", (evt) => {\n' +
    '  if (!myBox.classList.contains("hotpink")) {\n' +
    '    myBox.classList.add("hotpink");\n' +
    '    myBox.classList.replace("hotpink", "blue");\n' +
    '  } else {\n' +
    '    myBox.classList.replace("hotpink", "blue");\n' +
    '  }\n' +
    '});\n' +
    '\n' +
    'toggleBtn.addEventListener("click", (evt) => {\n' +
    '  myBox.classList.toggle("thick");\n' +
    '});The full Codepen is shown below.<iframe height="481.7393798828125" style="width: 100%;" scrolling="no" title="Untitled" src="https://codepen.io/caraya/embed/rNoZjEB?default-tab=result" frameborder="no" loading="lazy" allowtransparency="true" allowfullscreen="true">\n' +
