    '\t--open-sans-regular-ss02: "ss02" off;\n' +
    '\t--open-sans-regular-ss03: "ss03" off;\n' +
    '\t--open-sans-regular-ss04: "ss04" off;\n' +
    '\t--open-sans-regular-subs: "subs" off;\n' +
    '\t--open-sans-regular-sups: "sups" off;\n' +
    '\t--open-sans-regular-tnum: "tnum" off;\n' +
    '\t--open-sans-regular-zero: "zero" off;\n' +
    '}\n' +
