    "import React from 'react';\n" +
    '\n' +
    'export const GenericCard = ({\n' +
    '  title,\n' +
    '  image,\n' +
    '  subtitle,\n' +
    '  type,\n' +
    '  onBuy,\n' +
    '  onlineStatus,\n' +
