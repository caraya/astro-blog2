  textOnPage: 'Measuring long tasks in our code// Test for long tasks\n' +
    "test('should capture long tasks on the page', async ({ page }) => {\n" +
    '\t// Function to capture long tasks\n' +
    '\tasync function captureLongTasks(durationThreshold) {\n' +
    'return page.evaluate((threshold) => {\n' +
    '\t\treturn new Promise((resolve) => {\n' +
    '\t\t\tconst longTasks = [];\n' +
    '\t\t\tconst observer = new PerformanceObserver((list) => {\n' +
    '\t\t\t\t\tfor (const entry of list.getEntries()) {\n' +
    '\t\t\t\t\t\tif (entry.duration > threshold) {\n' +
    '\t\t\t\t\t\t\tlongTasks.push(entry);\n' +
    '\t\t\t\t\t\t}\n' +
    '\t\t\t\t\t}\n' +
    '\t\t\t});\n' +
    "\t\t\tobserver.observe({ entryTypes: ['longtask'] });\n" +
    '\n' +
    '\t\t\t// Assuming the long tasks will be captured within a certain time frame\n' +
    '\t\t\tsetTimeout(() => {\n' +
    '\t\t\t\tobserver.disconnect();\n' +
    '\t\t\t\tresolve(longTasks);\n' +
    '\t\t\t}, 5000); // Adjust the timeout as needed\n' +
    '\t\t\t});\n' +
    '\t\t}, durationThreshold);\n' +
    '\t}\n' +
    '\n' +
    '\t// Capture long tasks\n' +
    '\t// 50ms as the threshold for long tasks\n' +
    '\tconst longTasks = await captureLongTasks(50);\n' +
    '\n' +
    '\t// Assertions with expect\n' +
    '\texpect(longTasks).toBeInstanceOf(Array);\n' +
    '\t// Expect no more than 5 long tasks\n' +
    '\texpect(longTasks.length).toBeLessThanOrEqual(5);\n' +
    '});Does the page generate errors if external resources don’t load?test("Tests if page will work when 3rd party resources are blocked", async ({ page }) => {\n' +
    '  page.route("**", (route) => {\n' +
    '    const requestURL = route.request().url()\n' +
    '\n' +
    '    if (requestURL.match(/http:\\/\\/localhost:8080/)) {\n' +
    '      route.continue()\n' +
    '    } else {\n' +
    '      route.abort()\n' +
    '    }\n' +
    '  })\n' +
    '\n' +
    '  // monitor emitted page errors\n' +
    '  const errors = []\n' +
    '  page.on("pageerror", (error) => {\n' +
    '    errors.push(error)\n' +
    '  })\n' +
    '\n' +
    '  await page.goto("http://localhost:8080")\n' +
    '\n' +
    '  console.log(errors)\n' +
    '  expect(errors.length).toBe(0)\n' +
    '})The impact of service workers on performance measurementThe impact of the device you’re testing with',
