---
import { getCollection } from 'astro:content';
import { Temporal } from '@js-temporal/polyfill';
import { toBlogDate } from '../../utils/blogPosts';

const isDev = import.meta.env.DEV;

// Get all posts for the sidebar
const allPosts = await getCollection('blog');

// Sort by date newest first
const sortedPosts = allPosts.sort((a, b) =>
  Temporal.PlainDate.compare(toBlogDate(b.data.date), toBlogDate(a.data.date))
);

// We need to pass the raw data and body to the client
const clientPostsData = sortedPosts.map(post => {
  let ext = '.md';
  // Astro 4 content entries with glob loader usually have a filePath property
  if ((post as any).filePath && (post as any).filePath.endsWith('.mdx')) {
    ext = '.mdx';
  }

  return {
    id: post.id,
    ext: ext,
    data: {
      ...post.data,
      date: toBlogDate(post.data.date).toString() // Serialize Temporal dates to strings
    },
    body: post.body
  };
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Post Editor</title>
    <!-- Toast UI Editor (Loaded via Vite below) -->
    <style>
      body { margin: 0; padding: 0; font-family: system-ui, sans-serif; background: #f5f5f5; color: #333; }
      .editor-container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
      /* Additional styles handled in the scoped style block below */
    </style>
  </head>
  <body>
    <div class="editor-container">
      {isDev ? (
        <div class="editor-ui">
        
        <div class="editor-header-bar">
          <div class="header-left">
            <h2>Select Post</h2>
            <select id="post-selector" class="post-list-select">
              <option value="">-- Create New Post --</option>
              {sortedPosts.map(post => (
                <option value={post.id}>{post.data.title}</option>
              ))}
            </select>
            <button id="btn-new-post" class="btn primary small">New</button>
          </div>
          <div class="header-actions">
            <span id="save-status" class="status-msg"></span>
            <button id="btn-save" class="btn success">Save Post</button>
          </div>
        </div>

        {/* EDITOR PANELS */}
        <div class="editor-content">
          <div class="editor-toolbar">
            <h2 id="editor-title">Create New Post</h2>
          </div>

          <form id="editor-form" class="editor-form">
            <div class="form-grid">
              {/* CORE METADATA */}
              <div class="form-group span-2">
                <label for="f-title">Title *</label>
                <input type="text" id="f-title" name="title" required />
              </div>

              <div class="form-group slug-group">
                <label for="f-slug">Filename Slug *</label>
                <div class="slug-input-wrapper">
                  <input type="text" id="f-slug" name="slug" placeholder="my-awesome-post" required />
                  <select id="f-ext" name="ext" class="ext-select">
                    <option value=".md">.md</option>
                    <option value=".mdx">.mdx</option>
                  </select>
                </div>
                <input type="hidden" id="f-originalSlug" name="originalSlug" />
                <input type="hidden" id="f-originalExt" name="originalExt" />
              </div>

              <div class="form-group">
                <label for="f-date">Date (MM/DD/YYYY) *</label>
                <input type="text" id="f-date" name="date" placeholder="05/15/2024" pattern="\d{1,2}/\d{1,2}/\d{4}" title="Date must be in MM/DD/YYYY format" required />
              </div>

              <div class="form-group">
                <label for="f-author">Author</label>
                <input type="text" id="f-author" name="author" value="Carlos Araya" />
              </div>

              <div class="form-group span-2">
                <label for="f-desc">Description</label>
                <textarea id="f-desc" name="desc" rows="2"></textarea>
              </div>

              <div class="form-group">
                <label for="f-categories">Categories (comma separated)</label>
                <input type="text" id="f-categories" name="categories" />
              </div>

              <div class="form-group">
                <label for="f-tags">Tags (comma separated)</label>
                <input type="text" id="f-tags" name="tags" />
              </div>

              <div class="form-group span-2">
                <label for="f-status">Publishing Status</label>
                <select id="f-status" name="status" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
                  <option value="first-draft">First Draft</option>
                  <option value="needs-review">Needs Review</option>
                  <option value="ready-to-publish">Ready to Publish</option>
                </select>
              </div>

              {/* FLAGS / BOOLEANS */}
              <div class="form-group span-2 flags-group">
                <label class="checkbox-label">
                  <input type="checkbox" id="f-baseline" name="baseline" />
                  Baseline
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" id="f-colorjs" name="colorjs" />
                  Color.js
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" id="f-youtube" name="youtube" />
                  YouTube
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" id="f-mermaid" name="mermaid" />
                  Mermaid
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" id="f-sandpack" name="sandpack" />
                  Sandpack
                </label>
              </div>
            </div>

            {/* MARKDOWN EDITOR */}
            <div class="markdown-editor-group">
              <label>Markdown Content</label>
              <div id="f-body-editor"></div>
            </div>
          </form>
        </div>
        </div>
      ) : (
        <div style="text-align: center; margin-top: 20vh;">
          <h1>Development Mode Required</h1>
          <p>The post editor is only available during local development.</p>
          <a href="/" style="padding: 0.5rem 1rem; background: #3498db; color: white; text-decoration: none; border-radius: 4px;">Return to Site</a>
        </div>
      )}
    </div>
  </body>
</html>

<!-- Toast UI Editor JS (Bundled by Vite) -->
<script>
  import Editor from '@toast-ui/editor';
  import '@toast-ui/editor/dist/toastui-editor.css';
  
  window.ToastEditor = Editor;
  window.dispatchEvent(new Event('ToastEditorReady'));
</script>

<script is:inline define:vars={{ clientPostsData }}>
  // Ensure we are only running this in the browser
  if (typeof window !== 'undefined') {
    function initEditorApp() {
      if (!window.ToastEditor) {
        window.addEventListener('ToastEditorReady', initEditorApp, { once: true });
        return;
      }

      const form = document.getElementById('editor-form');
      const btnNew = document.getElementById('btn-new-post');
      const btnSave = document.getElementById('btn-save');
      const statusMsg = document.getElementById('save-status');
      const editorTitle = document.getElementById('editor-title');
      const postSelector = document.getElementById('post-selector');

      let currentPostId = null;

      // Initialize Toast UI Editor
      const editor = new window.ToastEditor({
        el: document.getElementById('f-body-editor'),
        initialEditType: 'markdown',
        previewStyle: 'tab',
        height: '600px',
        initialValue: ''
      });

    // Helper to format date for input type="text" (MM/DD/YYYY)
    function formatDateForInput(dateStr) {
      let d;
      if (!dateStr) {
        d = new Date();
      } else {
        // Append time to ensure we parse the exact UTC day without timezone shifts
        d = new Date(dateStr.substring(0, 10) + 'T12:00:00Z');
      }
      
      if (isNaN(d.getTime())) return dateStr; // fallback if invalid

      const mm = String(d.getUTCMonth() + 1).padStart(2, '0');
      const dd = String(d.getUTCDate()).padStart(2, '0');
      const yyyy = d.getUTCFullYear();
      return `${mm}/${dd}/${yyyy}`;
    }

    // Load a post into the form
    function loadPost(id) {
      if (!id) {
        clearForm();
        return;
      }

      const post = clientPostsData.find(p => p.id === id);
      if (!post) return;

      currentPostId = id;
      editorTitle.textContent = `Edit Post`;

      // Update active state in sidebar list
      if (postSelector && postSelector.value !== id) {
        postSelector.value = id;
      }

      // Populate form fields
      document.getElementById('f-originalSlug').value = id;
      document.getElementById('f-originalExt').value = post.ext || '.md';
      document.getElementById('f-slug').value = id;
      document.getElementById('f-ext').value = post.ext || '.md';
      document.getElementById('f-title').value = post.data.title || '';
      document.getElementById('f-date').value = formatDateForInput(post.data.date);
      document.getElementById('f-author').value = post.data.author || 'Carlos Araya';
      document.getElementById('f-desc').value = post.data.desc || '';
      document.getElementById('f-categories').value = (post.data.categories || []).join(', ');
      document.getElementById('f-tags').value = (post.data.tags || []).join(', ');

      // Status
      document.getElementById('f-status').value = post.data.status || (post.data.draft ? 'first-draft' : 'ready-to-publish');

      // Booleans
      document.getElementById('f-baseline').checked = !!post.data.baseline;
      document.getElementById('f-colorjs').checked = !!post.data.colorjs;
      document.getElementById('f-youtube').checked = !!post.data.youtube;
      document.getElementById('f-mermaid').checked = !!post.data.mermaid;
      document.getElementById('f-sandpack').checked = !!post.data.sandpack;

      // Markdown body
      editor.setMarkdown(post.body || '');
      statusMsg.textContent = '';
    }

    // Clear form for a new post
    function clearForm() {
      currentPostId = null;
      editorTitle.textContent = 'Create New Post';
      if (postSelector) postSelector.value = '';

      form.reset();
      document.getElementById('f-originalSlug').value = '';
      document.getElementById('f-originalExt').value = '';
      document.getElementById('f-ext').value = '.md';
      document.getElementById('f-date').value = formatDateForInput(new Date().toISOString());
      document.getElementById('f-author').value = 'Carlos Araya';
      document.getElementById('f-status').value = 'first-draft';
      editor.setMarkdown('');
      statusMsg.textContent = '';
    }

    // Save the post
    async function savePost() {
      const slug = document.getElementById('f-slug').value.trim();
      if (!slug) {
        alert("Filename slug is required.");
        return;
      }

      btnSave.disabled = true;
      statusMsg.textContent = 'Saving...';
      statusMsg.className = 'status-msg';

      // Transform MM/DD/YYYY to YYYY-MM-DD
      const rawDate = document.getElementById('f-date').value.trim();
      let isoDate = rawDate;
      const dateParts = rawDate.split('/');
      if (dateParts.length === 3) {
        isoDate = `${dateParts[2]}-${dateParts[0].padStart(2, '0')}-${dateParts[1].padStart(2, '0')}`;
      }

      const frontmatter = {
        title: document.getElementById('f-title').value,
        date: isoDate,
        author: document.getElementById('f-author').value,
        desc: document.getElementById('f-desc').value,
        categories: document.getElementById('f-categories').value.split(',').map(s => s.trim()).filter(Boolean),
        tags: document.getElementById('f-tags').value.split(',').map(s => s.trim()).filter(Boolean),
        status: document.getElementById('f-status').value,
        draft: document.getElementById('f-status').value !== 'ready-to-publish',
        baseline: document.getElementById('f-baseline').checked,
        colorjs: document.getElementById('f-colorjs').checked,
        youtube: document.getElementById('f-youtube').checked,
        mermaid: document.getElementById('f-mermaid').checked,
        sandpack: document.getElementById('f-sandpack').checked,
      };

      const payload = {
        slug: slug,
        ext: document.getElementById('f-ext').value,
        originalSlug: document.getElementById('f-originalSlug').value,
        originalExt: document.getElementById('f-originalExt').value,
        frontmatter: frontmatter,
        body: editor.getMarkdown()
      };

      try {
        const response = await fetch('/api/save-post', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (result.success || response.ok) {
          statusMsg.textContent = 'Saved successfully!';
          statusMsg.classList.add('success-text');

          // Update original tracking fields
          document.getElementById('f-originalSlug').value = slug;
          document.getElementById('f-originalExt').value = document.getElementById('f-ext').value;
          currentPostId = slug;
          editorTitle.textContent = `Edit Post`;

          // Refresh the page after saving to ensure clientPostsData is updated 
          // and Astro's content layer is forced to re-read the file.
          setTimeout(() => {
            window.location.reload();
          }, 800);
        } else {
          statusMsg.textContent = `Error: ${result.error}`;
          statusMsg.classList.add('error-text');
        }
      } catch (err) {
        statusMsg.textContent = 'Network error during save.';
        statusMsg.classList.add('error-text');
      } finally {
        btnSave.disabled = false;
      }
    }

    // Event Listeners
    if (btnNew) btnNew.addEventListener('click', clearForm);
    if (btnSave) btnSave.addEventListener('click', (e) => { e.preventDefault(); savePost(); });

    if (postSelector) {
      postSelector.addEventListener('change', (e) => {
        loadPost(e.target.value);
      });
    }

    // Auto-generate slug from title if new post
    const titleInput = document.getElementById('f-title');
    const slugInput = document.getElementById('f-slug');

    titleInput.addEventListener('blur', () => {
      if (!currentPostId && !slugInput.value && titleInput.value) {
        slugInput.value = titleInput.value
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)+/g, '');
      }
    });

    // Auto-load post from URL query string if present (e.g. from the calendar)
    const urlParams = new URLSearchParams(window.location.search);
    const postToLoad = urlParams.get('post');
    if (postToLoad) {
      loadPost(postToLoad);
    }
    } // End initEditorApp
    
    // Start the app when DOM is ready
    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', initEditorApp);
    } else {
      initEditorApp();
    }
  }
</script>

<style>
  .editor-main {
    max-width: 1400px;
    margin: 0 auto;
    height: calc(100vh - 100px); /* rough estimate to keep it full screen */
  }

  .editor-ui {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .editor-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: white;
    padding: 1rem 1.5rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-gray-20, #e5e5e5);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-grow: 1;
  }

  .header-left h2 {
    margin: 0;
    font-size: 1.1rem;
    white-space: nowrap;
  }

  .post-list-select {
    flex-grow: 1;
    max-width: 500px;
    padding: 0.5rem;
    border: 1px solid var(--color-gray-40, #ccc);
    border-radius: 0.3rem;
    font-family: inherit;
    font-size: 0.95rem;
    background: white;
  }

  .post-list-select option {
    padding: 0.5rem;
    border-bottom: 1px solid var(--color-gray-10, #f9f9f9);
    cursor: pointer;
  }

  .post-list-select option:checked {
    background: var(--color-accent, #3b82f6);
    color: white;
  }

  /* EDITOR CONTENT */
  .editor-content {
    display: flex;
    flex-direction: column;
    background: white;
    padding: 2rem;
    border: 1px solid var(--color-gray-20, #e5e5e5);
    border-radius: 0.5rem;
  }

  .editor-toolbar {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-gray-20, #e5e5e5);
  }

  .editor-toolbar h2 {
    font-size: 1.5rem;
    margin: 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .status-msg {
    font-size: 0.9rem;
    font-weight: 500;
  }
  .success-text { color: var(--color-green, #22c55e); }
  .error-text { color: var(--color-red, #ef4444); }

  /* FORM STYLES */
  .editor-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 900px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .span-2 {
    grid-column: span 2;
  }

  .form-group label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-gray-80, #333);
  }

  .form-group input[type="text"],
  .form-group input[type="date"],
  .form-group textarea,
  .form-group select {
    padding: 0.5rem;
    border: 1px solid var(--color-gray-40, #ccc);
    border-radius: 0.3rem;
    font-family: inherit;
    font-size: 1rem;
  }

  .slug-input-wrapper {
    display: flex;
    gap: 0.5rem;
  }

  .slug-input-wrapper input {
    flex-grow: 1;
  }

  .slug-input-wrapper select {
    width: 80px;
    background: white;
  }

  .flags-group {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 1rem;
    background: var(--color-gray-10, #f9f9f9);
    border-radius: 0.5rem;
    border: 1px solid var(--color-gray-20, #e5e5e5);
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: normal !important;
    cursor: pointer;
  }

  /* MARKDOWN AREA */
  .markdown-editor-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .markdown-editor-group label {
    font-weight: 600;
    font-size: 1.1rem;
    border-bottom: 2px solid var(--color-gray-20, #e5e5e5);
    padding-bottom: 0.5rem;
  }

  .markdown-textarea {
    width: 100%;
    padding: 1rem;
    font-family: 'Menlo', 'Monaco', 'Courier New', monospace;
    font-size: 0.95rem;
    line-height: 1.5;
    border: 1px solid var(--color-gray-40, #ccc);
    border-radius: 0.3rem;
    resize: vertical;
    background: #fafafa;
  }

  .markdown-textarea:focus {
    outline: none;
    border-color: var(--color-accent, #3b82f6);
    background: white;
  }

  /* BUTTONS */
  .btn {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 0.3rem;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .btn.small {
    padding: 0.35rem 0.75rem;
    font-size: 0.85rem;
  }

  .btn:hover {
    opacity: 0.9;
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn.primary {
    background: var(--color-accent, #3b82f6);
    color: white;
  }

  .btn.success {
    background: var(--color-green, #22c55e);
    color: white;
  }

  .warning {
    padding: 2rem;
    background: #fee2e2;
    color: #991b1b;
    border-radius: 0.5rem;
    text-align: center;
    font-weight: bold;
    margin: 2rem auto;
    max-width: 600px;
  }

  @media (max-width: 1024px) {
    .editor-header-bar {
      flex-direction: column;
      align-items: stretch;
    }
    
    .header-left {
      flex-wrap: wrap;
    }
    
    .post-list-select {
      max-width: 100%;
    }
    
    .form-grid {
      grid-template-columns: 1fr;
    }
    
    .span-2 {
      grid-column: span 1;
    }
  }
</style>
