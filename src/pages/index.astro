---
import Layout from '../layouts/Layout.astro';
import { getBlogPosts, paginateBlogPosts, POSTS_PER_PAGE, toBlogDate } from '../utils/blogPosts';

const allPosts = await getBlogPosts();
const { currentPage, totalPages, posts } = paginateBlogPosts(allPosts, 1, POSTS_PER_PAGE);

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import Excerpt from '../components/Excerpt.astro';
---
<Layout frontmatter={{ title: 'The Publishing Project' }}>
	<Header />
	<main>
		{posts.length === 0 ? (
			<div class="no-posts">
				<p>No posts have been published yet.</p>
			</div>
		) : (
			<>
				<section class="posts-grid" aria-label="Blog posts">
					{posts.map((post) => {
						const postDate = post.data.date.toString();

						return (
							<article class="post-card">
								<h2>
									<a href={`/${post.id}`}>{post.data.title}</a>
								</h2>
								<div class="post-metadata">
									<span>By {post.data.author}</span>
									<span aria-hidden="true">•</span>
									<time datetime={postDate} class="published iconfont">
										{toBlogDate(post.data.date).toLocaleString('en-US', { dateStyle: 'long' })}
									</time>
								</div>

								<Excerpt content={post.body} />

								<div class="continue-reading">
									<a href={`/${post.id}`}>Continue reading &rarr;</a>
								</div>
							</article>
						);
					})}
				</section>

				{totalPages > 1 && (
					<nav class="pagination" aria-label="Blog pagination">
						<span class="pagination-link is-disabled" aria-disabled="true">
							Newer posts
						</span>
						<span class="pagination-status">Page {currentPage} of {totalPages}</span>
						<a class="pagination-link" href="/page/2">
							Older posts
						</a>
					</nav>
				)}
			</>
		)}
	</main>
	<Footer />
</Layout>
