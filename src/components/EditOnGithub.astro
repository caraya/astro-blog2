---
interface Props {
  postId: string;
  collection?: string;
}

// Default to the 'blog' collection if not specified
const { postId, collection = 'blog' } = Astro.props;

// Change these to match your actual GitHub setup
const repoName = "astro-blog2";
const githubRepo = `https://github.com/caraya/${repoName}`;
const branch = "main";

const editUrl = `${githubRepo}/edit/${branch}/src/content/${collection}/${postId}`;
---

<!-- /**
 * A component that provides a link to edit the current blog post on GitHub.
 * It constructs the URL based on the post ID and collection, defaulting to the 'blog' collection.
 * The link opens in a new tab and includes an SVG icon.

 Example usage:

```astro
import EditOnGithub from '../components/EditOnGithub.astro';

// ... inside the layout template:
<TableOfContent headings={renderedPost?.headings ?? []} />
  {Content && <Content />}
<EditOnGithub postId={post.id} />
```

*/
 -->
<div class="edit-on-github">
  <a href={editUrl} target="_blank" rel="noopener noreferrer">
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
    </svg>
    Edit this post on GitHub
  </a>
</div>

<style>
  .edit-on-github {
    margin-block: 2rem;
  }
  .edit-on-github a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-gray-50, #666);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }
  .edit-on-github a:hover {
    color: var(--accent-color, #0056b3);
    text-decoration: underline;
  }
</style>
