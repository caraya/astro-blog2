---
import { getBlogPosts } from '../utils/blogPosts';

interface Props {
  count?: number;
  posts?: any[];
}

const { count = 10, posts } = Astro.props;

// If posts are passed down as a prop, use them directly (optimized).
// Otherwise, fallback to fetching them internally.
let latestPosts = posts || [];
if (!posts) {
  const allPosts = await getBlogPosts();
  latestPosts = allPosts;
}

latestPosts = latestPosts.slice(0, count);
---

<!--
   ---
    // Import the component
    import LatestPosts from '../components/LatestPosts.astro';
    ---

    Defaults to showing the 10 most recent posts
    <LatestPosts />

    Or you can configure it to show any number of posts!
    <LatestPosts count={5} />
 -->

<ul class="latest-posts">
  {latestPosts.map((post) => (
    <li>
      <a href={`/${post.id}`}>{post.data.title}</a>
    </li>
  ))}
</ul>
